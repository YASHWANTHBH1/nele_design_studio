
/* Mobile overflow and media safety */
html, body {
  max-width: 100vw;
  overflow-x: hidden;
}

img, picture, video, iframe {
  max-width: 100%;
  height: auto;
  display: block;
}

/* Ensure main layout grids collapse on very small screens (extra safety) */
@media (max-width: 480px) {
  .hero { grid-template-columns: 1fr; }
  .section-band { padding-left: 18px; padding-right: 18px; }
}
